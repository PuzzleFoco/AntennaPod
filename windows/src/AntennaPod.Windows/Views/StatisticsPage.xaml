<Page
    x:Class="AntennaPod.Windows.Views.StatisticsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Enabled">

    <ScrollViewer Padding="24">
        <StackPanel Spacing="24">
            <TextBlock Text="Statistics" Style="{StaticResource TitleTextBlockStyle}" />

            <!-- Summary cards -->
            <Grid ColumnSpacing="16" RowSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Total podcasts -->
                <Border Grid.Column="0" CornerRadius="8" Padding="20"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel>
                        <FontIcon Glyph="&#xE774;" FontSize="24" Margin="0,0,0,12"
                                 Foreground="{StaticResource AntennaPodAccentLightBrush}" />
                        <TextBlock x:Name="TotalPodcasts" Text="0" Style="{StaticResource TitleLargeTextBlockStyle}" />
                        <TextBlock Text="Subscriptions" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- Total episodes -->
                <Border Grid.Column="1" CornerRadius="8" Padding="20"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel>
                        <FontIcon Glyph="&#xEA69;" FontSize="24" Margin="0,0,0,12"
                                 Foreground="{StaticResource AntennaPodAccentLightBrush}" />
                        <TextBlock x:Name="TotalEpisodes" Text="0" Style="{StaticResource TitleLargeTextBlockStyle}" />
                        <TextBlock Text="Episodes" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- Played -->
                <Border Grid.Column="2" CornerRadius="8" Padding="20"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel>
                        <FontIcon Glyph="&#xE73E;" FontSize="24" Margin="0,0,0,12"
                                 Foreground="{StaticResource AntennaPodAccentLightBrush}" />
                        <TextBlock x:Name="PlayedEpisodes" Text="0" Style="{StaticResource TitleLargeTextBlockStyle}" />
                        <TextBlock Text="Played" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- Downloaded -->
                <Border Grid.Column="3" CornerRadius="8" Padding="20"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel>
                        <FontIcon Glyph="&#xE896;" FontSize="24" Margin="0,0,0,12"
                                 Foreground="{StaticResource AntennaPodAccentLightBrush}" />
                        <TextBlock x:Name="DownloadedEpisodes" Text="0" Style="{StaticResource TitleLargeTextBlockStyle}" />
                        <TextBlock Text="Downloaded" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
