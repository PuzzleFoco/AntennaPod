<Window
    x:Class="AntennaPod.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AntennaPod.Windows"
    Title="AntennaPod">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Custom title bar -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE95A;" FontSize="18" Margin="0,0,12,0" />
                <TextBlock Text="AntennaPod" Style="{StaticResource CaptionTextBlockStyle}"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- Navigation -->
        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="True"
            PaneDisplayMode="Left"
            IsPaneToggleButtonVisible="True"
            SelectionChanged="NavView_SelectionChanged"
            Loaded="NavView_Loaded">

            <NavigationView.MenuItems>
                <NavigationViewItem Content="Podcasts" Tag="podcasts">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE774;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Episodes" Tag="episodes">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEA69;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Queue" Tag="queue">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8FD;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Discover" Tag="discover">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE721;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Downloads" Tag="downloads">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE896;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Statistics" Tag="statistics">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D9;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="Sync" Tag="sync">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE895;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Frame x:Name="ContentFrame" />
        </NavigationView>

        <!-- Now Playing Bar -->
        <Grid x:Name="NowPlayingBar" Grid.Row="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0"
              Padding="16,8" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Episode info -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="40" Height="40" CornerRadius="4" Margin="0,0,12,0">
                    <Border.Background>
                        <SolidColorBrush Color="{ThemeResource SystemAccentColor}" Opacity="0.3" />
                    </Border.Background>
                    <FontIcon Glyph="&#xE768;" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="NowPlayingTitle" Text="No episode playing"
                               Style="{StaticResource BodyTextBlockStyle}" MaxWidth="300"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="NowPlayingPodcast" Text=""
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" MaxWidth="300"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </StackPanel>

            <!-- Progress -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="24,0">
                <Slider x:Name="PlaybackSlider" Minimum="0" Maximum="100" Value="0" />
                <Grid>
                    <TextBlock x:Name="PlaybackPosition" Text="0:00"
                               Style="{StaticResource CaptionTextBlockStyle}" HorizontalAlignment="Left" />
                    <TextBlock x:Name="PlaybackDuration" Text="0:00"
                               Style="{StaticResource CaptionTextBlockStyle}" HorizontalAlignment="Right" />
                </Grid>
            </StackPanel>

            <!-- Playback controls -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <Button x:Name="SkipBackButton" Style="{StaticResource SubtleButtonStyle}"
                        Width="36" Height="36" Padding="0" ToolTipService.ToolTip="Skip back 10s">
                    <FontIcon Glyph="&#xED3C;" FontSize="14" />
                </Button>
                <Button x:Name="PlayPauseButton" Width="40" Height="40" Padding="0"
                        ToolTipService.ToolTip="Play/Pause">
                    <FontIcon x:Name="PlayPauseIcon" Glyph="&#xE768;" FontSize="18" />
                </Button>
                <Button x:Name="SkipForwardButton" Style="{StaticResource SubtleButtonStyle}"
                        Width="36" Height="36" Padding="0" ToolTipService.ToolTip="Skip forward 30s">
                    <FontIcon Glyph="&#xED3D;" FontSize="14" />
                </Button>
            </StackPanel>

            <!-- Volume -->
            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                <FontIcon Glyph="&#xE995;" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                <Slider x:Name="VolumeSlider" Width="100" Minimum="0" Maximum="100" Value="100"
                        VerticalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
