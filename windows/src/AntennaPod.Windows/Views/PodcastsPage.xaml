<Page
    x:Class="AntennaPod.Windows.Views.PodcastsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AntennaPod.Windows.Views"
    NavigationCacheMode="Enabled">

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Podcasts" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button x:Name="RefreshButton" Click="RefreshButton_Click" ToolTipService.ToolTip="Refresh all feeds">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72C;" FontSize="14" />
                        <TextBlock Text="Refresh" />
                    </StackPanel>
                </Button>
                <Button x:Name="AddButton" Style="{StaticResource AccentButtonStyle}" Click="AddButton_Click"
                        ToolTipService.ToolTip="Add podcast">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE710;" FontSize="14" />
                        <TextBlock Text="Add Podcast" />
                    </StackPanel>
                </Button>
                <DropDownButton ToolTipService.ToolTip="Import/Export">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8B5;" FontSize="14" />
                        <TextBlock Text="Import/Export" />
                    </StackPanel>
                    <DropDownButton.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="Import OPML" Click="ImportOpml_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8E5;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Export OPML" Click="ExportOpml_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xEDE1;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
            </StackPanel>
        </Grid>

        <!-- Empty state -->
        <StackPanel x:Name="EmptyState" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Visibility="Collapsed">
            <FontIcon Glyph="&#xE774;" FontSize="48" Opacity="0.5" HorizontalAlignment="Center" Margin="0,0,0,16" />
            <TextBlock Text="No podcasts yet" Style="{StaticResource SubtitleTextBlockStyle}"
                       HorizontalAlignment="Center" Opacity="0.7" />
            <TextBlock Text="Add a podcast feed URL or import from OPML to get started"
                       Style="{StaticResource BodyTextBlockStyle}" HorizontalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,8,0,24" />
            <Button Style="{StaticResource AccentButtonStyle}" Click="AddButton_Click"
                    HorizontalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE710;" FontSize="14" />
                    <TextBlock Text="Add Your First Podcast" />
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- Podcast grid -->
        <GridView x:Name="PodcastGrid" Grid.Row="1" SelectionMode="None"
                  IsItemClickEnabled="True" ItemClick="PodcastGrid_ItemClick">
            <GridView.ItemTemplate>
                <DataTemplate>
                    <Grid Width="200" Padding="8" Margin="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="200" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Podcast artwork -->
                        <Border Grid.Row="0" CornerRadius="8"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <Grid>
                                <FontIcon Glyph="&#xE774;" FontSize="48" Opacity="0.3"
                                         HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Image Source="{Binding ImageUrl}" Stretch="UniformToFill" />
                            </Grid>
                        </Border>

                        <!-- Title -->
                        <TextBlock Grid.Row="1" Text="{Binding Title}"
                                   Style="{StaticResource BodyStrongTextBlockStyle}"
                                   TextTrimming="CharacterEllipsis" MaxLines="2"
                                   Margin="0,8,0,0" />

                        <!-- Author -->
                        <TextBlock Grid.Row="2" Text="{Binding Author}"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis" MaxLines="1" />
                    </Grid>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>

        <!-- Loading indicator -->
        <ProgressRing x:Name="LoadingRing" Grid.Row="1" IsActive="False"
                      HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Grid>
</Page>
